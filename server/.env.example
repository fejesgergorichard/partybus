# Copy to .env and fill in.
# Register an app at https://developer.spotify.com/dashboard
# Redirect URI to register on Spotify: http://127.0.0.1:5173/auth/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/auth/callback

# Where the browser lives — used to redirect back after OAuth.
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Express session secret — any random string for local dev.
SESSION_SECRET=change-me-in-prod

PORT=3000
