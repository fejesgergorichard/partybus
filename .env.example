# Copy to .env and fill in.
# Register the Spotify app at https://developer.spotify.com/dashboard
# Redirect URIs to register on Spotify:
#   http://127.0.0.1:5173/auth/callback        (local dev)
#   https://<your-vercel-app>.vercel.app/auth/callback   (prod)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/auth/callback

# Where the browser lives — used to redirect back after OAuth.
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Express session secret — any random string. In prod use openssl rand -hex 32.
SESSION_SECRET=change-me

# MongoDB Atlas SRV connection string.
MONGODB_URI=
MONGODB_DB=partybus

# Local dev only; Vercel ignores this.
PORT=3000
